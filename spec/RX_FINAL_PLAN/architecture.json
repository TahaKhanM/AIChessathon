    "hidden_activation_ruling": "Square the unclipped shifted affine before clipping the square output. Stockfish@59aae690f91d6f69aac194f447d84b4a2c3be778 src/nnue/layers/sqr_clipped_relu.h and PlentyChess@04e07a98ee6ac104c30e7374450c94b96d94ef4d nnue.cpp are the pinned definition references. Negative pre-activations can produce positive square-channel activations.",
    "leaf_transform": "cp = clip(((dot + psqt) * scale_num) >> scale_shift, -neural_bound, +neural_bound), computed in int64 (head.rescale_dtype); the constants are recorded in the trained export RXF1 _meta, never edited beneath existing weights",
    "leaf_transform_export_defaults": {
      "scale_num": 275,
      "scale_shift": 8,
      "neural_bound": 27951,
      "neural_bound_basis": "MATE_IN_MAX - 1 = mate_band_start - 1: strictly inside the mate band [27952, 30000)"
    }
  },
